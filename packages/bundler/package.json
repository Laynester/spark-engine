{
  "name": "@spark/bundler",
  "version": "0.1.1",
  "type": "module",
  "description": "Bundles exported Director casts into .spark/.zip archives for the Lingo runtime. Install globally: npm i -g @spark/bundler, then `spark bundle <exported> <out-dir>`.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "spark": "dist/cli.js",
    "habbo-bundle": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=dist/bundler.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.21.0",
    "typescript": "^5.5.0"
  }
}
